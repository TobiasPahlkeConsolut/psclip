# Pinned entries saved by "Keep pinned entries" (pinned.dat, pinned-<InstanceName>.dat, the temporary file while
# writing and files set aside as unreadable) - personal data, even though encrypted: never commit them.
/pinned*.dat
/pinned*.dat.*

# Settings (settings.ini, settings-<InstanceName>.ini and the temporary file while writing) - each user's own
/settings*.ini
/settings*.ini.*

# Release ZIPs built by tools\New-ReleaseZip.ps1 - attached to the GitHub release, not committed
/dist/
